# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LLM provider: "gemini" (real) or "fake" (offline, deterministic; used by tests and demos)
LLM_PROVIDER=gemini

# Gemini model. Default: gemini-3.8-flash, a current Flash-class model that supports
# function calling and is available on the Gemini API free tier (see README, "Model choice").
LLM_MODEL=gemini-3.8-flash

# SEC EDGAR requires every client to identify itself: "Your Name your.email@example.com"
EDGAR_USER_AGENT=

# Base URL of the author's Stock Screener HTTP API (optional). The agent's
# get_screener_result tool calls SCREENER_URL + SCREENER_PATH.
SCREENER_URL=
SCREENER_PATH=/api/screener/{ticker}

# Local embedding model (sentence-transformers, downloaded once to data/hf_cache)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional overrides
# DATA_DIR=./data
# CHROMA_DIR=./chroma_db
# TOP_K=5
