# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LLM provider: "gemini" (real, default), "ollama" (a local model, nothing leaves this
# computer; see the OLLAMA_* settings below) or "fake" (offline, deterministic; used by tests)
LLM_PROVIDER=gemini

# Gemini model. Default: gemini-3.5-flash-lite, a current Flash-class (Flash-Lite) model that
# supports function calling and is on the Gemini API free tier. The evaluation and the agent
# run were done with it. gemini-3.8-flash also works but its free tier allows only 20
# requests per day, fewer than one evaluation run needs (see README, "Model choice").
LLM_MODEL=gemini-3.5-flash-lite

# Gemini 3 "thinking" level: minimal | low | medium | high. Empty = model default
# (use empty for Gemini 2.x models, which do not support thinking levels).
LLM_THINKING_LEVEL=low

# Local model through Ollama (used only when LLM_PROVIDER=ollama). The client talks only to
# a loopback host (localhost, 127.0.0.1, ::1); any other OLLAMA_HOST is refused unless
# ALLOW_REMOTE_LLM=1 is set on purpose. One attempt per call, no retries.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_S=180
# OLLAMA_NUM_CTX=8192
# OLLAMA_TOOL_MODE=auto        # auto | native | json (how the agent's tool calls are made)
# ALLOW_REMOTE_LLM=            # leave empty

# SEC EDGAR requires every client to identify itself: "Your Name your.email@example.com"
EDGAR_USER_AGENT=

# Base URL of the author's Stock Screener HTTP API (optional). The agent's
# get_screener_result tool calls SCREENER_URL + SCREENER_PATH.
SCREENER_URL=
SCREENER_PATH=/api/screener/{ticker}

# Local embedding model (sentence-transformers, downloaded once to data/hf_cache)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval: "hybrid" (vectors + BM25 keyword search, default) or "vector" (vectors only)
RETRIEVAL_MODE=hybrid

# Optional overrides
# DATA_DIR=./data
# CHROMA_DIR=./chroma_db
# TOP_K=5
